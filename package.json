{
  "name": "wedding-manager",
  "version": "1.0.0",
  "description": "Wedding invitation & guest management service",
  "main": "src/index.js",
  "type": "module",
  "imports": {
    "#api/*": "./src/api/*.js",
    "#lib/*": "./src/lib/*.js",
    "#conf": "./conf/index.js",
    "#test/*": "./test/*.js"
  },
  "scripts": {
    "build": "rm -rf web/public/js/*; rm -rf web/public/css/*; set -a; . .env && NODE_ENV=production npx webpack-cli build --config web/webpack.config.js",
    "build-hot": "set -a; . .env && npx webpack serve --config web/webpack.config.js --progress",
    "lint": "eslint ./ && stylelint \"./web/src/**/*.{scss,vue}\"",
    "start": "node --dns-result-order ipv4first src/index.js",
    "test": "npm run lint && npm run test:unit",
    "test:coverage": "node test/runner.js --coverage",
    "test:unit": "node test/runner.js",
    "watch": "set -a; . .env && DEBUG=wedding-manager:* node --dns-result-order ipv4first --watch-path=./src --watch-path=./conf --watch-preserve-output src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nboxhallburnett/wedding-manager.git"
  },
  "author": "Nathan Boxhall-Burnett <nathan@nbb.dev>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nboxhallburnett/wedding-manager/issues"
  },
  "homepage": "https://github.com/nboxhallburnett/wedding-manager#readme",
  "dependencies": {
    "compression": "1.8.2",
    "connect-mongo": "6.0.0",
    "cookie-parser": "1.4.7",
    "debug": "4.4.3",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "google-auth-library": "11.1.0",
    "ical-generator": "11.1.2",
    "mongodb": "7.7.0",
    "nanoid": "5.1.11",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@jpinsonneau/html-to-image": "1.11.13",
    "@popperjs/core": "2.11.8",
    "@stylistic/stylelint-config": "5.0.0",
    "@stylistic/stylelint-plugin": "5.3.1",
    "autoprefixer": "10.6.1",
    "bootstrap": "5.3.8",
    "css-loader": "7.1.5",
    "eslint": "10.12.0",
    "eslint-config-axway": "11.0.0",
    "eslint-node-test": "0.3.0",
    "eslint-plugin-vue": "10.11.1",
    "glob": "13.0.6",
    "mini-css-extract-plugin": "2.10.2",
    "mongodb-memory-server": "11.3.0",
    "node-mocks-http": "1.18.1",
    "postcss-loader": "8.2.1",
    "purgecss-webpack-plugin": "8.0.0",
    "qr-code-styling": "1.9.2",
    "sass": "1.105.1",
    "sass-loader": "17.0.1",
    "style-loader": "4.0.0",
    "stylelint": "17.16.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "vue": "3.5.43",
    "vue-loader": "17.4.2",
    "vue-router": "5.3.1",
    "vue-showdown": "4.2.0",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0",
    "webpack-manifest-plugin": "6.0.1"
  },
  "engines": {
    "node": ">=24.16.0",
    "npm": ">=11.13.0"
  }
}
