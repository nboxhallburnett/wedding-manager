# ==============================================================================
# Wedding Manager - Docker Compose Database Administration Configuration.
# Copy this file to `.env.db` if you wish to override the MongoDB container
# root administrator credentials or customize the initial admin user.
# These values are used during MongoDB initialization and are separate from
# the configuration used by the application itself.
# ==============================================================================

# MongoDB container root administrator credentials
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpassword

# Initial wedding-manager admin user
INITIAL_ADMIN_ID=admin
